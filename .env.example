# Kopieren nach .env und ausfüllen. .env wird nie committet.
ANTHROPIC_API_KEY=sk-ant-...
# Mindestens 8 Zeichen. Wer ihn kennt, kommt in die Demo.
ZUGANGSCODE=
# Zufallswert, z. B. python3 -c "import secrets; print(secrets.token_hex(32))". Ohne: nach jedem Neustart neu anmelden.
SESSION_SECRET=
